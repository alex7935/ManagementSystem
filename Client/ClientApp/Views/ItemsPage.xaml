<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClientApp.ViewModels"
             xmlns:models="clr-namespace:ClientApp.Models"
             x:Class="ClientApp.Views.ItemsPage"
             Title="Курси викладача">
    <ContentPage.BindingContext>
        <vm:ItemsViewModel />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="Auto,*,Auto" Padding="15" RowSpacing="10">
        <Label Grid.Row="0" Text="{Binding WelcomeText}" FontSize="18" FontAttributes="Bold" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Courses}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CourseItem">
                    <Frame Margin="0,5" Padding="12" BorderColor="LightGray">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" FontSize="13" TextColor="Gray" />
                            <Label Text="{Binding Semester, StringFormat='Семестр: {0}'}" FontSize="12" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="2" Text="+ Подати пропозицію щодо курсу" Command="{Binding GoToCreateProposalCommand}" />
    </Grid>
</ContentPage>