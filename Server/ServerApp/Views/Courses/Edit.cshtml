@model ServerApp.Models.Course
@{ ViewData["Title"] = "Редагувати курс"; }
<h2>Редагувати курс</h2>
<form method="post">
    <input type="hidden" name="ID" value="@Model.ID" />
    <div class="mb-3"><label>Назва</label><input name="Name" value="@Model.Name" class="form-control" required /></div>
    <div class="mb-3"><label>Опис</label><input name="Description" value="@Model.Description" class="form-control" /></div>
    <div class="mb-3"><label>Семестр</label><input name="Semester" value="@Model.Semester" class="form-control" required /></div>
    <div class="mb-3"><label>Викладач</label>
        <select name="TeacherID" class="form-select">
            @foreach (var item in (SelectList)ViewBag.Teachers) {
                <option value="@item.Value" selected="@(item.Value == Model.TeacherID.ToString())">@item.Text</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Оновити</button>
    <a href="/Courses" class="btn btn-secondary">Скасувати</a>
</form>