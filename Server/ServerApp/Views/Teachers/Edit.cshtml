@model ServerApp.Models.Teacher
@{ ViewData["Title"] = "Редагувати викладача"; }
<h2>Редагувати викладача</h2>
<form method="post">
    <input type="hidden" name="ID" value="@Model.ID" />
    <div class="mb-3"><label>Ім'я</label><input name="Name" value="@Model.Name" class="form-control" required /></div>
    <div class="mb-3"><label>Email</label><input name="Email" type="email" value="@Model.Email" class="form-control" required /></div>
    <div class="mb-3"><label>Новий пароль (залиште порожнім, щоб не змінювати)</label><input name="newPassword" type="password" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Оновити</button>
    <a href="/Teachers" class="btn btn-secondary">Скасувати</a>
</form>